# Local env example for trading_bot
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

TELEGRAM_SIGNAL_BOT_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=HTML
